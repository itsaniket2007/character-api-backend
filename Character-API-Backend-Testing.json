    {
      "name": "03 - Create Post",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "http://localhost:5000/api/posts"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Naruto Uzumaki\",\n  \"description\": \"Ninja of the Hidden Leaf\",\n  \"series\": \"Naruto\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Create a post. The test script automatically saves the returned MongoDB ID as postId for subsequent requests. Expected status: 201 Created."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "const data = pm.response.json();",
              "const createdPostId = data._id || (data.post && data.post._id) || (data.data && data.data._id);",
              "if (createdPostId) {",
              "    pm.collectionVariables.set(\"postId\", createdPostId);",
              "    console.log(\"Saved postId:\", createdPostId);",
              "} else {",
              "    console.warn(\"Post ID was not found in the response. Set postId manually before running requests 05-07.\");",
              "}"
            ]
          }
        }
      ]
    },
